{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink",
  "version": "../package.json",
  "identifier": "dev.blink.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Blink",
        "width": 1200,
        "height": 780,
        "minWidth": 860,
        "minHeight": 520,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "blink"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1RjQ3OTA0OTJFMDkzRjQKUldUMGsrQ1NCSG4wbFhmblR5QzFidjBWVzVVN0RZUFhzVGdnV3VKOWRNYUp3REo3dW0xVkp5YlIK",
      "endpoints": [
        "https://github.com/lilmonkeylv/blink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "lilmonkeylv",
    "homepage": "https://github.com/lilmonkeylv/blink",
    "license": "MIT",
    "copyright": "Copyright (c) 2026 lilmonkeylv",
    "category": "DeveloperTool",
    "shortDescription": "A fast Git client for GitHub",
    "longDescription": "Blink is a GitHub Desktop style Git client with a native Rust core. Status, history, diffs and blame run in-process, so large repositories stay responsive.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ],
        "section": "vcs",
        "desktopTemplate": "linux/blink.desktop"
      },
      "rpm": {
        "depends": [
          "git"
        ],
        "desktopTemplate": "linux/blink.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
